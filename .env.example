# Copia este archivo como `.env` y completa los valores reales.
POSTGRES_DB=web2
POSTGRES_USER=user
POSTGRES_PASSWORD=CHANGEME

# Spring Datasource (apunta al puerto mapeado en docker-compose)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/web2
SPRING_DATASOURCE_USERNAME=user
SPRING_DATASOURCE_PASSWORD=CHANGEME

# Puerto de la app
SERVER_PORT=8081
